# RingMate environment template.
# Copy to .env and fill in your own keys:  copy .env.example .env
# NEVER commit .env to git — it holds real secrets (.gitignore blocks it).

# --- LLM (via OmniRoute gateway) ---
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=
OMNIROUTE_MODEL=

# --- Speech ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
SARVAM_API_KEY=
TTS_VOICE=
VOICE_LANGUAGE=en
WHISPER_MODEL=tiny.en

# --- Email ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
USER_EMAIL=

# --- Calendar (optional, read-only) ---
GOOGLE_CALENDAR_ICAL_URL=

# --- Phone calling (Exotel, server-side only) ---
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=

# --- Google Drive / OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_PATH=

# --- Misc ---
USER_HOME_CITY=Hyderabad
